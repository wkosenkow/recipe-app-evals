PORT=3000
NODE_ENV=development

# Local MongoDB, or an Atlas connection string. Include the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/kitchen-companion

# Origin allowed to call this API cross-origin. In production the frontend is
# served from the same origin, so set this to the deployed URL rather than
# leaving the dev default.
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Which model answers the cooking chat: "ollama" (default) or "anthropic".
# Ollama runs locally and needs no API key, so local dev costs nothing.
CHAT_PROVIDER=ollama

# Used when CHAT_PROVIDER=ollama. Pull the model first: ollama pull llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Required when CHAT_PROVIDER=anthropic — startup fails without it. This is what
# production uses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
